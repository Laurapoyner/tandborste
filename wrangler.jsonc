{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tandborste",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
